<?xml version="1.0" encoding="utf-8"?>
<!--
  Mister.Version: MSBuild integration.

  Imported by NuGet for single-targeted and inner (per-TFM) builds (build/), and by
  buildMultiTargeting/Mister.Version.targets for multi-targeting outer builds.

  How the version flows:
    * _MonoRepoSetVersion runs MonoRepoVersionTask once per project instance and sets Version, PackageVersion,
      AssemblyVersion, FileVersion and InformationalVersion.
    * Inner builds: it runs before PrepareForBuild/GetAssemblyVersion, so the SDK's own GenerateAssemblyInfo
      stamps the assembly (incrementally - unchanged versions do not trigger recompilation).
    * Pack (single- and multi-targeted): it runs via GenerateNuspecDependsOn before the nuspec and package file
      name are computed.
    * ProjectReference -> package dependency versions: NuGet calls _GetProjectVersion on referenced projects,
      which depends on $(GetPackageVersionDependsOn), where this target is registered.

  The task caches its result (in memory per node and in obj/ per project) keyed on a fingerprint of the
  repository state and all settings, so the git history walk happens at most once per project per state.
-->
<Project>

  <UsingTask TaskName="Mister.Version.MonoRepoVersionTask" AssemblyFile="$(_MrVersionTaskAssembly)" />
  <UsingTask TaskName="Mister.Version.HasChangesTask" AssemblyFile="$(_MrVersionTaskAssembly)" />

  <!-- Microsoft.Build.Traversal entry points (dirs.proj) only build other projects: nothing to version (it used to
       compute a meaningless version from a walk over every project it references) -->
  <PropertyGroup Condition="'$(UsingMicrosoftTraversalSdk)' == 'true'">
    <MonoRepoVersioningEnabled>false</MonoRepoVersioningEnabled>
  </PropertyGroup>

  <!-- Test projects are not versioned unless MonoRepoSkipTestProjects=false or mr-version.yml skipTestProjects: false:
       the task runs for them (cheaply: it returns no version for a skipped project), so the YAML setting applies as in the CLI -->

  <PropertyGroup Condition="'$(MonoRepoVersioningEnabled)' == 'true'">
    <!-- Mister.Version provides InformationalVersion; don't let the SDK append "+<commit sha>" to it. -->
    <IncludeSourceRevisionInInformationalVersion Condition="'$(IncludeSourceRevisionInInformationalVersion)' == ''">false</IncludeSourceRevisionInInformationalVersion>

    <_MrVersionCacheFile Condition="'$(_MrVersionCacheFile)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', '$(MSBuildProjectName).mrversion.cache'))</_MrVersionCacheFile>

    <!-- Make the version available to pack (single- and multi-targeted) and to NuGet's ProjectReference version lookup -->
    <GenerateNuspecDependsOn>_MonoRepoSetVersion;$(GenerateNuspecDependsOn)</GenerateNuspecDependsOn>
    <GetPackageVersionDependsOn>_MonoRepoSetVersion;$(GetPackageVersionDependsOn)</GetPackageVersionDependsOn>
  </PropertyGroup>

  <!-- ============================================================
       Version calculation
       ============================================================ -->
  <Target Name="_MonoRepoSetVersion"
          Condition="'$(MonoRepoVersioningEnabled)' == 'true'">

    <ItemGroup>
      <_MonoRepoDependencies Remove="@(_MonoRepoDependencies)" />
      <_MonoRepoDependencies Include="@(ProjectReference->'%(FullPath)')" />
    </ItemGroup>

    <MonoRepoVersionTask
      ProjectPath="$(MSBuildProjectFullPath)"
      RepoRoot="$(MonoRepoRoot)"
      TagPrefix="$(MonoRepoTagPrefix)"
      UpdateProjectFile="$(MonoRepoUpdateProjectFile)"
      ForceVersion="$(ForceVersion)"
      Debug="$(MonoRepoDebug)"
      ExtraDebug="$(MonoRepoExtraDebug)"
      SkipTestProjects="$(MonoRepoSkipTestProjects)"
      SkipNonPackableProjects="$(MonoRepoSkipNonPackableProjects)"
      IsTestProject="$(IsTestProject)"
      IsPackable="$(IsPackable)"
      PrereleaseType="$(MonoRepoPrereleaseType)"
      ConfigFile="$(MonoRepoConfigFile)"
      ConventionalCommitsEnabled="$(MonoRepoConventionalCommitsEnabled)"
      MajorPatterns="$(MonoRepoMajorPatterns)"
      MinorPatterns="$(MonoRepoMinorPatterns)"
      PatchPatterns="$(MonoRepoPatchPatterns)"
      IgnorePatterns="$(MonoRepoIgnorePatterns)"
      ChangeDetectionEnabled="$(MonoRepoChangeDetectionEnabled)"
      IgnoreFilePatterns="$(MonoRepoIgnoreFilePatterns)"
      MajorFilePatterns="$(MonoRepoMajorFilePatterns)"
      MinorFilePatterns="$(MonoRepoMinorFilePatterns)"
      PatchFilePatterns="$(MonoRepoPatchFilePatterns)"
      SourceOnlyMode="$(MonoRepoSourceOnlyMode)"
      AdditionalMonitorPaths="$(MonoRepoAdditionalMonitorPaths)"
      GenerateChangelog="$(MonoRepoGenerateChangelog)"
      ChangelogFormat="$(MonoRepoChangelogFormat)"
      ChangelogOutputPath="$(MonoRepoChangelogOutputPath)"
      ChangelogRepositoryUrl="$(MonoRepoChangelogRepositoryUrl)"
      ChangelogIncludeAuthors="$(MonoRepoChangelogIncludeAuthors)"
      ShallowCloneSupport="$(MonoRepoShallowCloneSupport)"
      ShallowCloneFallbackVersion="$(MonoRepoShallowCloneFallbackVersion)"
      SubmoduleSupport="$(MonoRepoSubmoduleSupport)"
      CustomTagPatterns="$(MonoRepoCustomTagPatterns)"
      BranchBasedVersioning="$(MonoRepoBranchBasedVersioning)"
      BranchVersioningRules="$(MonoRepoBranchVersioningRules)"
      IncludeBranchInMetadata="$(MonoRepoIncludeBranchInMetadata)"
      ValidateTagAncestry="$(MonoRepoValidateTagAncestry)"
      FetchDepth="$(MonoRepoFetchDepth)"
      VersionScheme="$(MonoRepoVersionScheme)"
      CalVerFormat="$(MonoRepoCalVerFormat)"
      CalVerStartDate="$(MonoRepoCalVerStartDate)"
      CalVerResetPatch="$(MonoRepoCalVerResetPatch)"
      CalVerSeparator="$(MonoRepoCalVerSeparator)"
      ValidationEnabled="$(MonoRepoValidationEnabled)"
      MinimumVersion="$(MonoRepoMinimumVersion)"
      MaximumVersion="$(MonoRepoMaximumVersion)"
      AllowedVersionRange="$(MonoRepoAllowedVersionRange)"
      ValidateDependencyVersions="$(MonoRepoValidateDependencyVersions)"
      RequireMajorApproval="$(MonoRepoRequireMajorApproval)"
      BlockedVersions="$(MonoRepoBlockedVersions)"
      RequireMonotonicIncrease="$(MonoRepoRequireMonotonicIncrease)"
      MajorVersionApproved="$(MonoRepoMajorVersionApproved)"
      EnableFileCache="$(MonoRepoEnableFileCache)"
      FileCachePath="$(MonoRepoFileCachePath)"
      EnableCache="$(MonoRepoVersionCacheEnabled)"
      CacheFile="$(_MrVersionCacheFile)"
      ProjectAssetsFile="$(ProjectAssetsFile)"
      RequireGitRepository="$(MonoRepoRequireGitRepository)"
      BranchName="$(MonoRepoBranchName)"
      Dependencies="@(_MonoRepoDependencies)">
      <Output TaskParameter="Version" PropertyName="FullVersion" />
      <Output TaskParameter="VersionChanged" PropertyName="VersionChanged" />
      <Output TaskParameter="DiscoveredRepoRoot" PropertyName="DiscoveredRepoRoot" />
    </MonoRepoVersionTask>

    <!-- A Version set by the project, Directory.Build.props or the command line (-p:Version) is replaced:
         ForceVersion is the way to pin a version. Say so (detailed verbosity) instead of dropping it silently. -->
    <Message Text="[MrVersion] $(MSBuildProjectName): replacing Version '$(Version)' with the calculated '$(FullVersion)' (set ForceVersion to pin a version)"
             Importance="Normal"
             Condition="'$(FullVersion)' != '' and '$(_MrVersionCalculated)' == '' and '$(Version)' != '' and '$(Version)' != '1.0.0' and '$(Version)' != '$(FullVersion)'" />

    <PropertyGroup Condition="'$(FullVersion)' != ''">
      <!-- Numeric part for AssemblyVersion/FileVersion: strip prerelease (-...) and build metadata (+...) -->
      <MainVersion>$(FullVersion.Split('-')[0].Split('+')[0])</MainVersion>
      <IsPrerelease>false</IsPrerelease>
      <IsPrerelease Condition="$(FullVersion.Split('+')[0].Contains('-'))">true</IsPrerelease>

      <Version>$(FullVersion)</Version>
      <PackageVersion>$(FullVersion)</PackageVersion>
      <AssemblyVersion>$(MainVersion)</AssemblyVersion>
      <FileVersion>$(MainVersion)</FileVersion>
      <InformationalVersion>$(FullVersion)</InformationalVersion>
      <_MrVersionCalculated>$(FullVersion)</_MrVersionCalculated>
    </PropertyGroup>

    <Message Text="[MrVersion] $(MSBuildProjectName) = $(FullVersion)" Importance="High" Condition="'$(MonoRepoDebug)' == 'true'" />
  </Target>

  <!-- Inner/single-TFM builds: compute the version before anything reads it during the build
       (assembly attributes via the SDK's GenerateAssemblyInfo, deps.json, publish, ...).
       Skipped for IDE design-time builds, which do not need it. -->
  <Target Name="_MonoRepoCalculateVersion"
          BeforeTargets="PrepareForBuild;GetAssemblyVersion"
          DependsOnTargets="_MonoRepoSetVersion"
          Condition="'$(MonoRepoVersioningEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'" />

  <!-- Multi-targeting outer build: Build only dispatches to the inner builds, so nothing above runs there. Compute
       the version before dispatching, so targets hooked on the outer Build (AfterTargets="Build", e.g. zipping or
       signing outputs once per project) see the same $(Version) as the inner builds. The result is cached. -->
  <Target Name="_MonoRepoCalculateVersionOuter"
          BeforeTargets="DispatchToInnerBuilds"
          DependsOnTargets="_MonoRepoSetVersion"
          Condition="('$(IsCrossTargetingBuild)' == 'true' or ('$(TargetFrameworks)' != '' and '$(TargetFramework)' == '')) and '$(MonoRepoVersioningEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'" />

  <!-- ============================================================
       HasChanges - standalone change detection (opt-in, not part of the normal build)
       ============================================================ -->
  <Target Name="_MonoRepoHasChanges"
          Condition="'$(MonoRepoVersioningEnabled)' == 'true'">
    <ItemGroup>
      <_MonoRepoDependencies Remove="@(_MonoRepoDependencies)" />
      <_MonoRepoDependencies Include="@(ProjectReference->'%(FullPath)')" />
    </ItemGroup>

    <HasChangesTask
      ProjectPath="$(MSBuildProjectFullPath)"
      RepoRoot="$(MonoRepoRoot)"
      TagPrefix="$(MonoRepoTagPrefix)"
      SinceTag="$(MonoRepoSinceTag)"
      SinceCommit="$(MonoRepoSinceCommit)"
      ChangeDetectionEnabled="$(MonoRepoChangeDetectionEnabled)"
      IgnoreFilePatterns="$(MonoRepoIgnoreFilePatterns)"
      MajorFilePatterns="$(MonoRepoMajorFilePatterns)"
      MinorFilePatterns="$(MonoRepoMinorFilePatterns)"
      PatchFilePatterns="$(MonoRepoPatchFilePatterns)"
      AdditionalMonitorPaths="$(MonoRepoAdditionalMonitorPaths)"
      Debug="$(MonoRepoDebug)"
      ProjectAssetsFile="$(ProjectAssetsFile)"
      Dependencies="@(_MonoRepoDependencies)">
      <Output TaskParameter="HasChanges" PropertyName="MonoRepoHasChanges" />
      <Output TaskParameter="ChangeType" PropertyName="MonoRepoChangeType" />
      <Output TaskParameter="ChangeReason" PropertyName="MonoRepoChangeReason" />
      <Output TaskParameter="ChangedFiles" ItemName="MonoRepoChangedFiles" />
      <Output TaskParameter="ComparedAgainst" PropertyName="MonoRepoComparedAgainst" />
      <Output TaskParameter="DiscoveredRepoRoot" PropertyName="DiscoveredRepoRoot" />
    </HasChangesTask>

    <Message Text="[MrVersion] HasChanges: $(MonoRepoHasChanges), Type: $(MonoRepoChangeType)" Importance="High" Condition="'$(MonoRepoDebug)' == 'true'" />
  </Target>

  <!-- Convenience target: dotnet msbuild -t:CheckForChanges -->
  <Target Name="CheckForChanges" DependsOnTargets="_MonoRepoHasChanges">
    <Message Text="Project has changes: $(MonoRepoHasChanges)" Importance="High" />
    <Message Text="Change type: $(MonoRepoChangeType)" Importance="High" Condition="'$(MonoRepoHasChanges)' == 'true'" />
    <Message Text="Reason: $(MonoRepoChangeReason)" Importance="High" />
    <Message Text="Compared against: $(MonoRepoComparedAgainst)" Importance="High" />
  </Target>

  <!-- Sets _MonoRepoShouldSkipBuild=true when the project has no changes (opt-in via MonoRepoSkipUnchanged=true) -->
  <Target Name="_MonoRepoConditionalBuild"
          DependsOnTargets="_MonoRepoHasChanges"
          Condition="'$(MonoRepoSkipUnchanged)' == 'true'">
    <PropertyGroup Condition="'$(MonoRepoHasChanges)' == 'false'">
      <_MonoRepoShouldSkipBuild>true</_MonoRepoShouldSkipBuild>
    </PropertyGroup>
    <Message Text="[MrVersion] No changes since $(MonoRepoComparedAgainst) - build may be skipped" Importance="High" Condition="'$(_MonoRepoShouldSkipBuild)' == 'true'" />
  </Target>

  <!-- Convenience target: dotnet msbuild -t:GetMrVersion -getProperty:Version -->
  <!-- On a Microsoft.Build.Traversal entry point (dirs.proj) it prints the version of every referenced project. -->
  <Target Name="GetMrVersion" DependsOnTargets="_MonoRepoSetVersion" Returns="$(Version)">
    <MSBuild Projects="@(ProjectReference)" Targets="GetMrVersion" SkipNonexistentTargets="true" BuildInParallel="true"
             Condition="'$(UsingMicrosoftTraversalSdk)' == 'true'" />
    <Message Text="$(MSBuildProjectName): $(Version)" Importance="High" Condition="'$(UsingMicrosoftTraversalSdk)' != 'true'" />
  </Target>

</Project>
