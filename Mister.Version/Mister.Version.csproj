<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- net472: Visual Studio / MSBuild.exe; net8.0: dotnet CLI MSBuild (also loads on .NET 9/10+ hosts) -->
		<TargetFrameworks>net472;net8.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<Title>Mister.Version</Title>
		<Description>Generates versions independently for C# projects in a mono-repo with enhanced dev and feature branch support.</Description>
		<PackageTags>versioning;git;monorepo;csharp;msbuild</PackageTags>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<RepositoryUrl>https://github.com/mr-version/mister.version</RepositoryUrl>
		<!-- This target will run when MSBuild is collecting the files to be packaged, and we'll implement it below. This property controls the dependency list for this packaging process, so by adding our custom property we hook ourselves into the process in a supported way. -->
		<TargetsForTfmSpecificBuildOutput>
			$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage
		</TargetsForTfmSpecificBuildOutput>
		<!-- This property tells MSBuild where the root folder of the package's build assets should be. Because we are not a library package, we should not pack to 'lib'. Instead, we choose 'tasks' by convention. -->
		<BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
		<!-- NuGet silently drops .so/.dylib from the build output folder unless they are allowed explicitly -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.so;.dylib</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<!-- NuGet does validation that libraries in a package are exposed as dependencies, but we _explicitly_ do not want that behavior for MSBuild tasks. They are isolated by design. Therefore we ignore this specific warning. -->
		<NoWarn>$(NoWarn);NU5100</NoWarn>
		<!-- Suppress NuGet warning NU5128. -->
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<!-- Tell the SDK to generate a deps.json file -->
		<GenerateDependencyFile>true</GenerateDependencyFile>
		<!-- Keep packages.lock.json (OS-independent, see the net472 reference below) -->
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<Import Project="$(ProjectDir)../Project.props" />

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="../icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" PrivateAssets="all" ExcludeAssets="Runtime">
		  <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="LibGit2Sharp" Version="0.31.0" PrivateAssets="all" />
		<!-- Native libgit2 for every RID: tasks/net8.0/runtimes/<rid>/native (resolved through the task's deps.json by
		     MSBuild's plugin load context) and tasks/net472/lib/win32/<arch> (LibGit2Sharp's .NET Framework probe path) -->
		<PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.323" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" PrivateAssets="all" />
		<PackageReference Include="System.Text.Json" Version="10.0.0" PrivateAssets="all" />
		<PackageReference Include="YamlDotNet" Version="16.3.0" PrivateAssets="all" />
	</ItemGroup>

	<!-- Reference the core project -->
	<ItemGroup>
		<ProjectReference Include="..\Mister.Version.Core\Mister.Version.Core.csproj" PrivateAssets="all" />
	</ItemGroup>

	<!-- The SDK only adds this implicitly on non-Windows hosts, which made packages.lock.json differ per OS.
	     Referencing it explicitly keeps the lock file identical on Windows, Linux and macOS. -->
	<ItemGroup Condition="'$(TargetFramework)'=='net472'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<Choose>
		<When Condition="'$(TargetFramework)'=='net472'">
			<PropertyGroup>
				<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
			</PropertyGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<Compile Remove="PathUtils.cs" />
			</ItemGroup>
		</Otherwise>
	</Choose>

	<Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<!-- Managed dependencies and (net8.0) runtimes/<rid>/native/* for all RIDs; DestinationSubPath keeps the
			     runtimes layout that the task's deps.json describes. Microsoft.Build.Framework comes from MSBuild itself. -->
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" TargetPath="%(ReferenceCopyLocalPaths.DestinationSubPath)"
			                      Condition="'%(ReferenceCopyLocalPaths.Filename)' != 'Microsoft.Build.Framework'" />
			<!-- net472: LibGit2Sharp loads <dir of LibGit2Sharp.dll>/lib/win32/{x86,x64,arm64}/git2-*.dll on .NET Framework,
			     so 32-bit and ARM64 MSBuild.exe work as well as x64 -->
			<BuildOutputInPackage Include="@(ContentWithTargetPath)" TargetPath="%(ContentWithTargetPath.TargetPath)"
			                      Condition="'$(TargetFramework)' == 'net472' and $([System.String]::new('%(ContentWithTargetPath.TargetPath)').StartsWith('lib\win32\'))" />
		</ItemGroup>
	</Target>

	<!-- This target adds the generated deps.json file to our package output -->
	<Target Name="AddBuildDependencyFileToBuiltProjectOutputGroupOutput" BeforeTargets="BuiltProjectOutputGroup" Condition=" '$(GenerateDependencyFile)' == 'true'">
		<ItemGroup>
			<BuiltProjectOutputGroupOutput Include="$(ProjectDepsFilePath)" TargetPath="$(ProjectDepsFileName)" FinalOutputPath="$(ProjectDepsFilePath)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<!-- these lines pack the build props/targets files to the `build` folder in the generated package.
        by convention, the .NET SDK will look for build\<Package Id>.props and build\<Package Id>.targets
        for automatic inclusion in the build. -->
		<Content Include="build\Mister.Version.props" PackagePath="build\" />
		<Content Include="build\Mister.Version.targets" PackagePath="build\" />

		<!-- Pack buildMultiTargeting files for outer build support (multi-targeting scenarios).
        by convention, the .NET SDK will look for buildMultiTargeting\<Package Id>.props and buildMultiTargeting\<Package Id>.targets
        for automatic inclusion during outer builds (when IsCrossTargetingBuild=true). -->
		<Content Include="buildMultiTargeting\Mister.Version.props" PackagePath="buildMultiTargeting\" />
		<Content Include="buildMultiTargeting\Mister.Version.targets" PackagePath="buildMultiTargeting\" />

	</ItemGroup>

</Project>