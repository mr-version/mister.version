<?xml version="1.0" encoding="utf-8"?>
<!--
  Imported by NuGet for multi-targeting outer builds ($(TargetFramework) is empty).
  The outer build needs the version for pack (GenerateNuspecDependsOn) and for NuGet's ProjectReference
  version lookup (_GetProjectVersion via GetPackageVersionDependsOn); both hooks live in the shared targets.
-->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)../build/Mister.Version.targets" />
</Project>
