<?xml version="1.0" encoding="utf-8"?>
<!--
  Imported by NuGet for multi-targeting outer builds ($(TargetFramework) is empty).
  Uses exactly the same defaults as single-targeted and inner builds, so the package version computed
  by the outer build (dotnet pack) always matches the version stamped into each TFM's assembly.
-->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)../build/Mister.Version.props" />
</Project>
